# 환경 — dev / staging / prod
# - dev: 콘솔 로그, security 헤더 일부 비활성 (HSTS), DEBUG OK
# - prod 외: JSON 로그, security 헤더 _모두_ 활성
APP_ENV=dev
APP_LOG_LEVEL=INFO

# ── DB ──────────────────────────────────────────────────────────
# 호스트 _개발자_ 기준. 도커 컨테이너 안에선 db:5432 override.
APP_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/app

# DB 풀 — _부하 측정 후_ 튜닝. 운영 default 는 보수적.
APP_DB_POOL_SIZE=5
APP_DB_MAX_OVERFLOW=10
APP_DB_POOL_RECYCLE=1800
APP_DB_POOL_TIMEOUT=30

# ── Redis ───────────────────────────────────────────────────────
APP_REDIS_URL=redis://localhost:6379/0

# ── JWT (access + refresh) ──────────────────────────────────────
# 운영: secrets.token_urlsafe(32) 으로 _반드시_ 교체. KMS / Vault / SealedSecrets.
APP_JWT_SECRET=change-me-access-secret-use-secrets-token-urlsafe-32
APP_REFRESH_SECRET=change-me-refresh-secret-different-from-access
APP_JWT_ALGORITHM=HS256
APP_JWT_EXPIRE_MIN=15
APP_REFRESH_EXPIRE_DAYS=7

# ── 캐시 TTL ────────────────────────────────────────────────────
APP_CACHE_TTL_SECONDS=60

# ── CORS ────────────────────────────────────────────────────────
# 쉼표 구분. 운영은 _명시적_ 도메인. 절대 `*` X.
APP_CORS_ORIGINS=http://localhost:3000,http://localhost:5173
APP_CORS_ALLOW_CREDENTIALS=true

# ── Rate limit ──────────────────────────────────────────────────
APP_RATE_LIMIT_LOGIN_PER_MIN=10

# ── Security ────────────────────────────────────────────────────
# CSP — API 전용. SPA 호스팅 시 script-src / connect-src 등 추가.
APP_CSP_POLICY=default-src 'self'; frame-ancestors 'none'
